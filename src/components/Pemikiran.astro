---
/** Section Pemikiran — grid policy brief. */
import { useTranslations, type Lang } from "../i18n/ui";
import { briefs } from "../data/content";
import { waLink } from "../data/site";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="pemikiran" class="pad py-section" style="background:var(--color-haze)">
  <div class="flex flex-col gap-8">
    <div class="flex flex-wrap gap-3 items-end justify-between">
      <div class="flex flex-col gap-3">
        <h2 class="disp type-2">{t("pemikiran.h2")}</h2>
        <p class="max-w-prose" style="color:var(--color-mute);font-size:16px">{t("pemikiran.sub")}</p>
      </div>
      <a class="pill pill--onlight" href={waLink("brief", lang)}>{t("pemikiran.cta")}</a>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
      {briefs.map((b) => (
        <article class="card">
          <span class="card__ico" aria-hidden="true">{b.ico}</span>
          <h3 style="font-weight:700;font-size:17px;line-height:1.35">{b.t[lang]}</h3>
          <p style="font-size:14px;color:var(--color-mute);line-height:1.5">{b.p[lang]}</p>
          <span class="badge">{b.status[lang]}</span>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .badge {
    margin-top: auto;
    font-size: 12px;
    font-weight: 700;
    color: var(--color-violet);
    letter-spacing: 0.05em;
  }
</style>
