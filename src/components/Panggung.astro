---
/** Section Panggung — daftar forum & rekam jejak. */
import Icon from "./Icon.astro";
import { useTranslations, type Lang } from "../i18n/ui";
import { talks } from "../data/content";
import { waLink } from "../data/site";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const speaking = [...talks].sort((a, b) => Number(b.yr.id.slice(0, 4)) - Number(a.yr.id.slice(0, 4)));
---

<section id="panggung" class="pad py-section" style="background:var(--color-night);color:#fff">
  <div class="grid gap-8 lg:grid-cols-12">
    <div class="lg:col-span-4 flex flex-col gap-4">
      <h2 class="disp h-2">{t("panggung.h2")}</h2>
      <p style="color:var(--color-fog);font-size:16px">{t("panggung.sub")}</p>
      <a class="pill" href={waLink("speak", lang)}>
        <span class="dot"><Icon name="arrow-right" /></span>
        {t("hero.cta1")}
      </a>
    </div>

    <div class="lg:col-span-8">
      <div>
        {speaking.map((talk) => (
          <div class="talk__row">
            <span class="talk__yr">{talk.yr[lang]}</span>
            {talk.href ? (
              <a class="talk__txt" href={talk.href} target="_blank" rel="noopener">{talk.t[lang]}</a>
            ) : (
              <span class="talk__txt">{talk.t[lang]}</span>
            )}
            <span class="talk__meta">{talk.m[lang]}</span>
          </div>
        ))}
      </div>
      <p style="color:var(--color-fog);font-size:13px;margin-top:16px">{t("panggung.note")}</p>
    </div>
  </div>
</section>

<style>
  .talk__txt { color: #fff; text-decoration: none; }
  a.talk__txt:hover { text-decoration: underline; text-underline-offset: 0.25em; }
</style>
