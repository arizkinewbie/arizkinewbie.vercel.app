---
/** Footer. */
import { useTranslations, type Lang } from "../i18n/ui";
import { site } from "../data/site";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="pad" style="background:var(--color-night);border-top:1px solid rgba(255,255,255,.1)">
  <div class="foot">
    <span>© {year} {site.name}. {t("footer.rights")}</span>
    <div class="foot__links">
      <a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a href={site.instagram} target="_blank" rel="noopener">Instagram</a>
      <a href={site.nbies} target="_blank" rel="noopener">Nbie Solutions</a>
      <a href={site.symptomed} target="_blank" rel="noopener">SymptoMed</a>
    </div>
  </div>
</footer>
