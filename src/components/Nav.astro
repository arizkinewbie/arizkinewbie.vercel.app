---
/**
 * Nav — header bar + menu mobile + language switch.
 * Sticky di atas hero, onlight=true untuk halaman dalam.
 */
import Icon from "./Icon.astro";
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  currentPath: string;
  onlight?: boolean;
}

const { lang, currentPath, onlight = false } = Astro.props;
const t = useTranslations(lang);

// Path tanpa prefix bahasa, untuk ditukar ke bahasa lain
const bare = currentPath.replace(/^\/(id|en)/, "") || "/";
const otherLang: Lang = lang === "id" ? "en" : "id";
const otherHref = `/${otherLang}${bare === "/" ? "/" : bare}`;

const links = [
  { href: `/${lang}/panggung/`, label: t("nav.panggung"), active: currentPath.includes("/panggung") },
  { href: `/${lang}/pemikiran/`, label: t("nav.pemikiran"), active: currentPath.includes("/pemikiran") },
  { href: `/${lang}/karya/`, label: t("nav.karya"), active: currentPath.includes("/karya") },
  { href: `/${lang}/tentang/`, label: t("nav.tentang"), active: currentPath.includes("/tentang") },
  { href: `/${lang}/kontak/`, label: t("nav.kontak"), active: currentPath.includes("/kontak") },
];
---

<div class:list={["bar", { "bar--onlight": onlight }]}>
  <a class="bar__brand" href={`/${lang}/`}>
    <span class="brand-long">{t("site.title")}</span>
    <span class="brand-short">Arizki P.R</span>
  </a>

  <nav class="nav-main" id="menu-utama" aria-label={lang === "id" ? "Utama" : "Main"}>
    {links.map((l) => (
      <a href={l.href} class:list={[{ "nav-link--active": l.active }]} aria-current={l.active ? "page" : undefined}>
        {l.label}
      </a>
    ))}
  </nav>

  <div class="bar__actions">
    <div class="lang" role="group" aria-label={t("lang.switch")}>
      <a href={lang === "id" ? currentPath : otherHref} aria-current={lang === "id" ? "true" : "false"}>ID</a>
      <a href={lang === "en" ? currentPath : otherHref} aria-current={lang === "en" ? "true" : "false"}>EN</a>
    </div>

    <button
      class="menu-toggle"
      type="button"
      aria-label={lang === "id" ? "Buka menu navigasi" : "Open navigation menu"}
      aria-expanded="false"
      aria-controls="menu-utama"
      data-menu-toggle
    >
      <Icon name="menu" size={22} />
    </button>
  </div>
</div>

<style>
  .nav-link--active {
    color: var(--color-lilac) !important;
    text-decoration: underline;
    text-underline-offset: 0.35em;
  }
  .bar--onlight .nav-link--active {
    color: var(--color-violet) !important;
  }
</style>

<script>
  // Mobile menu drawer toggle — robust, idempotent, and accessible
  (() => {
    if ((window as any).__navInitialized) return;
    (window as any).__navInitialized = true;

    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement | null;
      const btn = target?.closest<HTMLElement>("[data-menu-toggle]");

      if (btn) {
        e.stopPropagation();
        const nav = document.getElementById(btn.getAttribute("aria-controls") ?? "");
        if (!nav) return;
        const willOpen = btn.getAttribute("aria-expanded") !== "true";
        btn.setAttribute("aria-expanded", String(willOpen));
        nav.classList.toggle("open", willOpen);
        nav.inert = !willOpen;
        return;
      }

      // Klik di luar menu untuk menutup
      const openNav = document.querySelector<HTMLElement>(".nav-main.open");
      if (openNav && !target?.closest(".nav-main") && !target?.closest("[data-menu-toggle]")) {
        const toggleBtn = document.querySelector<HTMLElement>("[data-menu-toggle]");
        if (toggleBtn) toggleBtn.setAttribute("aria-expanded", "false");
        openNav.classList.remove("open");
        openNav.inert = true;
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        const openNav = document.querySelector<HTMLElement>(".nav-main.open");
        const btn = document.querySelector<HTMLElement>("[data-menu-toggle]");
        if (openNav && openNav.classList.contains("open")) {
          if (btn) {
            btn.setAttribute("aria-expanded", "false");
            btn.focus();
          }
          openNav.classList.remove("open");
          openNav.inert = true;
        }
      }
    });

    window.matchMedia("(min-width:1024px)").addEventListener("change", (e) => {
      if (e.matches) {
        const openNav = document.querySelector<HTMLElement>(".nav-main.open");
        const btn = document.querySelector<HTMLElement>("[data-menu-toggle]");
        if (btn) btn.setAttribute("aria-expanded", "false");
        if (openNav) {
          openNav.classList.remove("open");
          openNav.inert = false;
        }
      }
    });
  })();
</script>
