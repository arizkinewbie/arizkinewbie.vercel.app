---
/**
 * PageHeader — Header khusus untuk halaman dalam (Inner Pages).
 * Desain modern, konsisten, dengan Nav terintegrasi.
 */
import Nav from "./Nav.astro";
import Icon from "./Icon.astro";
import type { Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  currentPath: string;
  kicker: string;
  title: string;
  subtitle: string;
  ctaText?: string;
  ctaHref?: string;
}

const { lang, currentPath, kicker, title, subtitle, ctaText, ctaHref } = Astro.props;
---

<header class="page-hero">
  <div class="page-hero__grid" aria-hidden="true"></div>
  <div class="page-hero__glow" aria-hidden="true"></div>

  <div class="pad page-hero__inner">
    <Nav lang={lang} currentPath={currentPath} />

    <div class="page-hero__body">
      <div class="page-hero__kicker">
        <span class="chip"><i></i>{kicker}</span>
      </div>

      <h1 class="disp type-1 page-hero__title">{title}</h1>
      <p class="page-hero__sub">{subtitle}</p>

      {ctaText && ctaHref && (
        <div class="page-hero__cta">
          <a class="pill" href={ctaHref}>
            <span class="dot"><Icon name="arrow-right" /></span>
            {ctaText}
          </a>
        </div>
      )}
    </div>
  </div>
</header>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    background: var(--color-night);
    color: #ffffff;
    padding-bottom: 56px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .page-hero__grid {
    position: absolute;
    inset: 0;
    opacity: 0.12;
    background-image: linear-gradient(rgba(255, 255, 255, 0.4) 1px, transparent 1px),
                      linear-gradient(90deg, rgba(255, 255, 255, 0.4) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: linear-gradient(180deg, #000 0%, transparent 85%);
    -webkit-mask-image: linear-gradient(180deg, #000 0%, transparent 85%);
  }

  .page-hero__glow {
    position: absolute;
    top: -20%;
    right: 10%;
    width: 600px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(56, 189, 248, 0.12) 0%, rgba(99, 102, 241, 0.06) 50%, transparent 70%);
    pointer-events: none;
  }

  .page-hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .page-hero__body {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 820px;
    padding-top: 12px;
  }

  .page-hero__kicker {
    display: flex;
    align-items: center;
  }

  .page-hero__title {
    font-size: clamp(34px, 4.5vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .page-hero__sub {
    font-size: clamp(16px, 1.8vw, 19px);
    color: var(--color-fog);
    line-height: 1.6;
    max-width: 68ch;
  }

  .page-hero__cta {
    margin-top: 8px;
  }
</style>
