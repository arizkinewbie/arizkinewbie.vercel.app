---
/**
 * Ikon SVG inline — tanpa dependency, tanpa sprite file.
 * Pakai: <Icon name="arrow-right" size={18} />
 */
type IconName =
  | "arrow-right"
  | "menu"
  | "close"
  | "external"
  | "whatsapp"
  | "mail"
  | "linkedin"
  | "instagram";

interface Props {
  name: IconName;
  size?: number;
}

const { name, size = 18 } = Astro.props;

const icons: Record<IconName, string> = {
  "arrow-right": '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="m6 6 12 12M18 6 6 18"/>',
  external: '<path d="M7 17 17 7"/><path d="M7 7h10v10"/>',
  whatsapp:
    '<path d="M20.5 11.6a8.4 8.4 0 0 1-12.3 7.5L3.5 20.5l1.4-4.7a8.4 8.4 0 1 1 15.6-4.2Z"/><path d="M8.8 9.2c.2 3 2.3 5 5.2 5.2"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6.5 8.5 6 8.5-6"/>',
  linkedin: '<path d="M6 9.5v8.5"/><circle cx="6" cy="6" r="1.6"/><path d="M11 18v-5a3 3 0 0 1 6 0v5"/>',
  instagram:
    '<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17" cy="7.2" r="1"/>',
};
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={icons[name]}
/>
