---
/** Section Kontak — tiga CTA WhatsApp terisi otomatis + kontak langsung. */
import { useTranslations, type Lang } from "../i18n/ui";
import { site, waIntent, waLink, type WaIntent } from "../data/site";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const intents: WaIntent[] = ["speak", "brief", "work"];
---

<section id="kontak" class="pad py-section" style="background:var(--color-night);color:#fff">
  <div class="grid gap-8 lg:grid-cols-12 items-center">
    <div class="lg:col-span-6 flex flex-col gap-6">
      <h2 class="disp h-1">{t("kontak.h2a")}<br />{t("kontak.h2b")}</h2>
      <p style="color:var(--color-fog);font-size:17px;max-width:56ch">{t("kontak.sub")}</p>

      <div class="contact">
        {intents.map((k) => (
          <a href={waLink(k, lang)}>
            <strong>{waIntent[k].label[lang]} →</strong>
            <span>{waIntent[k].desc[lang]}</span>
          </a>
        ))}
      </div>
    </div>

    <div class="lg:col-span-6 contact-box">
      <p class="eyebrow">{t("kontak.direct")}</p>
      <div class="flex flex-col gap-3">
        <div class="contact-row">
          <span class="contact-lbl">WhatsApp</span>
          <a href={`https://wa.me/${site.phoneRaw}`}>{site.phone}</a>
        </div>
        <div class="contact-row">
          <span class="contact-lbl">Email</span>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </div>
        <div class="contact-row">
          <span class="contact-lbl">LinkedIn</span>
          <a href={site.linkedin} target="_blank" rel="noopener">/in/arizkinewbie</a>
        </div>
      </div>
      <p class="note">{t("kontak.mediakit")}</p>
    </div>
  </div>
</section>

<style>
  .contact-box {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 28px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
  }
  .eyebrow {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-lilac);
  }
  .contact-row { display: flex; flex-direction: column; gap: 2px; }
  .contact-lbl { font-size: 12px; color: var(--color-fog); }
  .contact-row a { font-weight: 700; text-decoration: none; }
  .contact-row a:hover { text-decoration: underline; text-underline-offset: 0.25em; }
  .note { font-size: 12px; color: var(--color-fog); line-height: 1.5; margin-top: 4px; }
  .note :global(strong) { color: #fff; }
</style>
