---
/**
 * Halaman utama — satu file untuk /id/ dan /en/.
 * generateStaticPaths membuat kedua bahasa saat build.
 */
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import About from "../../components/About.astro";
import Panggung from "../../components/Panggung.astro";
import Pemikiran from "../../components/Pemikiran.astro";
import Karya from "../../components/Karya.astro";
import Kontak from "../../components/Kontak.astro";
import Footer from "../../components/Footer.astro";
import { useTranslations, type Lang } from "../../i18n/ui";

export function getStaticPaths() {
  return [{ params: { lang: "id" } }, { params: { lang: "en" } }];
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
const currentPath = `/${lang}/`;

const title =
  lang === "id"
    ? "Arizki Putra Rahman | Full-Stack & AI Engineer, Founder, Aktivis Kebijakan"
    : "Arizki Putra Rahman | Full-Stack & AI Engineer, Founder, Policy Activist";
const description = t("hero.sub");
---

<Base lang={lang} title={title} description={description} path={currentPath}>
  <main id="isi">
    <Hero lang={lang} currentPath={currentPath} />
    <About lang={lang} />
    <Panggung lang={lang} />
    <Pemikiran lang={lang} />
    <Karya lang={lang} />
    <Kontak lang={lang} />
  </main>
  <Footer lang={lang} />
</Base>
